    message += `📍 Lokasi Maps: ${orderDetails.customerPinLocation}\n`;
  }
  message += `\n`;
  
  if (orderDetails.deliveryDateTime) {
    message += `📅 *Pre-Order - Masa Penghantaran:*\n`;
